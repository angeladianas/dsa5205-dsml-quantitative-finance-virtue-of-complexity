# Virtual environment
.venv/
env/
venv/

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Testing & linting caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# OS artifacts
.DS_Store
Thumbs.db

# Output caches (can be regenerated via pipeline)
output/results/
output/figures/

# Ignore raw uncompressed CSVs
data/*.csv

# Allow tracked compressed datasets
!data/*.csv.gz